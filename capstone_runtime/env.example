# Copy this to `.env` and fill in. The step scripts will source from environment.

# --- API keys / tokens --------------------------------------------------------
# HuggingFace; needed for any step that downloads a base / dataset.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional HF mirror — recommended in CN. Comment out if you don't use one.
# HF_ENDPOINT=https://hf-mirror.com

# GitHub PAT — needed for step 03 (private-PR extract) and step 02 (collect).
# Scope=repo:read is sufficient.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GLM-5.1 API — needed for step 01 (baseline comparison) and step 08/10
# (synthesis teacher). If you don't have one, the scripts skip those branches
# and just compare local models.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/v1

# Local serving endpoint produced by step 15. Step 18 reads this.
LLM_BASE_URL=http://localhost:30000/v1
LLM_API_KEY=sk-local
LLM_MODEL=capstone-air

# --- Paths --------------------------------------------------------------------
DATA_DIR=./data
CKPT_DIR=./ckpt
LOG_DIR=./logs

# Where you keep large HF caches (often a fast NVMe). Avoid your home dir if it's
# on slow disk — base downloads are ~200GB.
HF_HOME=/data/hf-cache

# --- Cluster ------------------------------------------------------------------
# Number of GPUs visible. Step launchers respect CUDA_VISIBLE_DEVICES.
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# Communication backend for distributed training.
# Override for non-NVLink topologies.
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
